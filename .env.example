# Provider keys (a person pastes these with: python3 scripts/keys.py set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LANGSMITH_API_KEY=
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cs-voice-agent
# Optional, public (no secret): the LangSmith page of that project, for the drawer's "Open in LangSmith" link,
# e.g. https://smith.langchain.com/o/<org id>/projects/p/<project id> . Read at web build time.
LANGSMITH_PROJECT_URL=
# Only if your LangSmith workspace is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Generated internal secrets (python3 scripts/keys.py gen); never commit real values
CORE_TOKEN_AGENT=
CORE_TOKEN_COMMIT=
CORE_TOKEN_OPS=
KNOWLEDGE_TOKEN_AGENT=
SESSION_SIGNING_KEY=
PIN_PEPPER=
OPERATOR_TOKEN_KEY=
DEMO_ACCESS_CODE=
OPERATOR_ACCESS_CODE=
POSTGRES_PASSWORD=
# Per-role Postgres passwords (generated); the six URLs below are composed from them by gen
AGENT_OWNER_PASSWORD=
AGENT_APP_PASSWORD=
CORE_OWNER_PASSWORD=
CORE_APP_PASSWORD=
KNOWLEDGE_OWNER_PASSWORD=
KNOWLEDGE_APP_PASSWORD=
# Composed database URLs (python3 scripts/keys.py gen); *_app is runtime, *_owner runs migrations
AGENT_DB_URL=
CORE_DB_URL=
KNOWLEDGE_DB_URL=
AGENT_DB_OWNER_URL=
CORE_DB_OWNER_URL=
KNOWLEDGE_DB_OWNER_URL=
# Non-secret config (defaults for local Docker Compose)
SITE_ORIGIN=http://localhost:3000
REDIS_URL=redis://redis:6379/0
DEMO_FAULTS_ENABLED=true
FEATURE_A4=false
CORE_URL=http://core:8000
KNOWLEDGE_URL=http://knowledge:8000
# Edge network subnet from compose (uvicorn trusts X-Forwarded-For only from here)
FORWARDED_ALLOW_IPS=172.30.0.0/24
# Compose edge network subnet; give each parallel stack its own (then set FORWARDED_ALLOW_IPS to the same value)
EDGE_SUBNET=172.30.0.0/24
# Edge (Caddy). SITE_ADDRESS: ":80" = plain http for local; on the VM set the public domain (certificate and https).
# Unset or empty makes Caddy refuse to start. Keep SITE_ORIGIN (the agent's Origin check) consistent with it:
# https://<domain> on the VM, http://localhost:<EDGE_PORT> locally. EDGE_PORT is the local host port (compose.override.yaml only).
SITE_ADDRESS=:80
# Agent startup check (CS-E-08.S5): production config = a SITE_ADDRESS that is not local (":80", ":<port>",
# localhost, 127.0.0.1) or AGENT_ENV=production. In production a pending Gate 2 verifier or PIN scanner fails
# startup; locally it only warns. Empty or placeholder tokens fail startup everywhere.
AGENT_ENV=
EDGE_PORT=3000
DEMO_RESEED=false
